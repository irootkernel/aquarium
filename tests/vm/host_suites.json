{
  "schema": "aquarium.vm-host-suites/v1",
  "common_env": {
    "HOME": "{guest_home}",
    "PATH": "{guest_path}",
    "AQUARIUM_EXPECTED_GUEST_UUID": "{expected_guest_uuid}",
    "AQUARIUM_GUEST_HOME": "{guest_home}",
    "AQUARIUM_GUEST_PYTHON": "{guest_python}",
    "AQUARIUM_DRIVER_PYTHON": "{driver_python}",
    "AQUARIUM_GUEST_CODEX": "{guest_codex}",
    "AQUARIUM_GUEST_PODWAY": "{guest_podway}",
    "AQUARIUM_MARKETPLACE_NAME": "{guest_marketplace_name}"
  },
  "suites": {
    "baseline": {
      "modes": [
        "auto"
      ],
      "environment_profile": "stable",
      "argv": [
        "/bin/sh",
        "tests/vm/recipes/guest_entry.sh",
        "--suite",
        "baseline"
      ],
      "cwd": "harness",
      "required_outputs": [
        "results/baseline/result.json",
        "results/baseline/inventories.json",
        "results/baseline/pre-normalization.json"
      ],
      "effects_mode": "live",
      "authorization_reference": "epic-019-vm-test-authority",
      "deadlines": {
        "queue_seconds": 26100,
        "prepare_seconds": 900,
        "run_seconds": 1800,
        "collect_seconds": 600,
        "cleanup_seconds": 900
      }
    },
    "install": {
      "modes": [
        "auto"
      ],
      "environment_profile": "candidate",
      "argv": [
        "/bin/sh",
        "tests/vm/recipes/guest_entry.sh",
        "--suite",
        "install"
      ],
      "cwd": "harness",
      "required_outputs": [
        "results/install/result.json",
        "results/install/inventories.json"
      ],
      "effects_mode": "live",
      "authorization_reference": "epic-019-vm-test-authority",
      "deadlines": {
        "queue_seconds": 26100,
        "prepare_seconds": 600,
        "run_seconds": 1800,
        "collect_seconds": 600,
        "cleanup_seconds": 900
      }
    },
    "upgrade": {
      "modes": [
        "auto"
      ],
      "environment_profile": "candidate",
      "argv": [
        "/bin/sh",
        "tests/vm/recipes/guest_entry.sh",
        "--suite",
        "upgrade"
      ],
      "cwd": "harness",
      "required_outputs": [
        "results/upgrade/result.json",
        "results/upgrade/inventories.json"
      ],
      "effects_mode": "live",
      "authorization_reference": "epic-019-vm-test-authority",
      "deadlines": {
        "queue_seconds": 26100,
        "prepare_seconds": 600,
        "run_seconds": 3600,
        "collect_seconds": 600,
        "cleanup_seconds": 1200
      }
    },
    "migration-failure": {
      "modes": [
        "auto"
      ],
      "environment_profile": "candidate",
      "argv": [
        "/bin/sh",
        "tests/vm/recipes/guest_entry.sh",
        "--suite",
        "migration-failure"
      ],
      "cwd": "harness",
      "required_outputs": [
        "results/migration-failure/result.json",
        "results/migration-failure/inventories.json"
      ],
      "effects_mode": "live",
      "authorization_reference": "epic-019-vm-test-authority",
      "deadlines": {
        "queue_seconds": 26100,
        "prepare_seconds": 600,
        "run_seconds": 3600,
        "collect_seconds": 600,
        "cleanup_seconds": 1200
      }
    },
    "manual-hold": {
      "modes": [
        "manual"
      ],
      "environment_profile": "candidate",
      "argv": [
        "/bin/sh",
        "tests/vm/recipes/guest_entry.sh",
        "--suite",
        "manual-hold",
        "--phase",
        "smoke"
      ],
      "setup_argv": [
        "/bin/sh",
        "-c",
        "umask 077 && printf '%s' \"$HAEPARI_PARENT_CONTEXT\" > ../operator-parent-context.json"
      ],
      "cwd": "harness",
      "required_outputs": [
        "results/manual-hold/result.json",
        "results/manual-hold/inventories.json",
        "results/manual-hold/smoke.json",
        "results/manual-hold/consumer-cleanup.json",
        "results/manual-hold/post-cleanup-inventory.json"
      ],
      "manual": {
        "scenario_document": "harness/tests/vm/recipes/scenarios/manual-hold.md",
        "required_scenarios": [
          "fixture-check",
          "discovery-check"
        ]
      },
      "effects_mode": "offline",
      "authorization_reference": "epic-019-vm-test-authority",
      "deadlines": {
        "queue_seconds": 26100,
        "prepare_seconds": 300,
        "manual_seconds": 3600,
        "collect_seconds": 600,
        "cleanup_seconds": 900,
        "run_seconds": 0
      }
    },
    "guard-failure-probe": {
      "modes": [
        "auto"
      ],
      "environment_profile": "stable",
